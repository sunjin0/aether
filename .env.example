# Admin、基础服务、MCP 与 Deep Agent 共用的 Docker 外部网络名称。
AETHER_SHARED_NETWORK=aether-mcp-server_default

# Java Admin 对外暴露的宿主机端口。
ADMIN_PORT=8080

# Admin/Front 优雅停机阶段超时；滚动发布时应覆盖为符合 drain 窗口的值。
SERVER_SHUTDOWN_TIMEOUT=30s

# Redis 容器在共享网络中的主机名。
REDIS_HOST=redis

# PostgreSQL JDBC 连接地址。
DB_URL=jdbc:postgresql://postgres:5432/aether

# PostgreSQL 登录用户名。
DB_USERNAME=aether

# PostgreSQL 登录密码。
DB_PASSWORD=aether_dev

# MinIO 服务在共享网络中的访问地址。
MINIO_ENDPOINT=http://minio:9000

# MinIO 访问密钥。
MINIO_ACCESS_KEY=minioadmin

# MinIO 私密访问密钥。
MINIO_SECRET_KEY=minioadmin

# 知识库文件使用的 MinIO Bucket 名称。
MINIO_KNOWLEDGE_BUCKET=aether-knowledge

# 普通上传文件使用的 MinIO Bucket 名称。
MINIO_FILE_BUCKET=aether

# 对象存储提供方：minio（默认）或 oss。设为 oss 时，OSS Bucket 请先在阿里云控制台创建；各业务使用对象键前缀隔离。
STORAGE_PROVIDER=minio
OSS_ENDPOINT=
# 可选：绑定的自定义域名，生成临时下载链接时使用。
OSS_PUBLIC_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=

# Deep Agent 服务在共享网络中的访问地址。
AETHER_DEEP_AGENT_BASE_URL=http://aether-deep-agent:8010

# Java 与 Deep Agent 回调验签共用的密钥。
AETHER_DEEP_AGENT_SHARED_SECRET=aether-deep-agent-dev-secret-change-me
ANYDOC_SERVICE_URL=http://aether-mcp:8000

# Java 签发、MCP 验证工具委托 JWT 共用的密钥。
AETHER_MCP_DELEGATION_SECRET=aether-mcp-delegation-dev-secret-change-me

# OIDC 默认关闭；本地 Keycloak 联调示例参见 docker-compose.identity.yml。
AETHER_OIDC_ENABLED=false
AETHER_OIDC_ISSUER_URI=
AETHER_OIDC_AUTHORIZATION_URI=
AETHER_OIDC_TOKEN_URI=
AETHER_OIDC_JWKS_URI=
AETHER_OIDC_CLIENT_ID=
AETHER_OIDC_CLIENT_SECRET=
AETHER_OIDC_REDIRECT_URI=
AETHER_OIDC_AUTO_PROVISION=false
AETHER_OIDC_SCOPES=openid,profile,email

# SCIM 默认关闭；启用时必须配置专用凭据和绑定租户，不得复用用户登录令牌。
AETHER_SCIM_ENABLED=false
AETHER_SCIM_BASE_PATH=/scim/v2
AETHER_SCIM_BEARER_TOKEN=
AETHER_SCIM_TENANT_ID=

# SAML 默认关闭；当前仅提供安全配置契约，尚未开放登录回调。
AETHER_SAML_ENABLED=false
AETHER_SAML_METADATA_DRIVEN=false
AETHER_SAML_ENTITY_ID=
AETHER_SAML_METADATA_URI=
AETHER_SAML_IDP_ENTITY_ID=
AETHER_SAML_CERTIFICATE=
AETHER_SAML_SSO_URL=
AETHER_SAML_REDIRECT_URI=
AETHER_ADMIN_OTEL_ENABLED=false
AETHER_ADMIN_OTEL_ENDPOINT=http://127.0.0.1:4318/v1/traces
AETHER_ADMIN_OTEL_SERVICE_NAME=aether-admin
AETHER_ADMIN_OTEL_LOGS_ENABLED=false
AETHER_ADMIN_OTEL_LOGS_ENDPOINT=http://127.0.0.1:4318/v1/logs

# 外部 Secret Provider 默认使用本地实现；可选 vault 或 kubernetes，启用前必须配置租户隔离路径和访问凭据。
AETHER_SECRET_PROVIDER=local
AETHER_VAULT_API_BASE=https://vault:8200
AETHER_VAULT_TOKEN=
AETHER_KUBERNETES_NAMESPACE=default
AETHER_KUBERNETES_API_BASE=https://kubernetes.default.svc:443
AETHER_KUBERNETES_BEARER_TOKEN=

# MCP OpenTelemetry 默认关闭；启用时填写 Collector OTLP/HTTP endpoints。
AETHER_OTLP_TRACES_ENABLED=false
AETHER_OTLP_TRACES_URL=
AETHER_OTLP_LOGS_URL=
AETHER_MCP_OTEL_SERVICE_NAME=aether-mcp-server

# Sandbox Runner 使用的服务级凭据；仅 Runner 可领取任务，生产环境必须替换。
AETHER_SANDBOX_RUNNER_TOKEN=aether-sandbox-runner-dev-secret-change-me

# 由 MCP 使用：解析文档的内嵌图片时调用 OpenAI 兼容视觉模型；三项均配置后启用。
AETHER_VISION_API_BASE_URL=
AETHER_VISION_MODEL=
AETHER_VISION_API_KEY=

# 生产环境必须在未提交的 .env 或密钥管理系统中替换数据库、MinIO 和两类委托密钥。
