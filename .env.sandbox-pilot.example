# Copy to .env.sandbox-pilot. Do not commit the copied file.
POSTGRES_DB=aether
POSTGRES_USER=aether
POSTGRES_PASSWORD=replace-with-a-strong-db-password
MINIO_ROOT_USER=aether-minio
MINIO_ROOT_PASSWORD=replace-with-a-strong-minio-password
AETHER_SANDBOX_RUNNER_TOKEN=replace-with-a-random-runner-token
AETHER_SANDBOX_RUNNER_ID=sandbox-pilot-1
AETHER_DEEP_AGENT_SHARED_SECRET=replace-with-existing-shared-secret
AETHER_MCP_DELEGATION_SECRET=replace-with-existing-delegation-secret

# Use absolute paths on the deployment host. Never rely on an assumed sibling
# checkout layout, or an old remote branch may accidentally be released.
AETHER_ADMIN_SOURCE=.
AETHER_MCP_SOURCE=/srv/aether-mcp-server
AETHER_DASHBOARD_SOURCE=/srv/aether-dashboard

ADMIN_PORT=18080
DASHBOARD_PORT=18001
MINIO_PUBLIC_ENDPOINT=http://localhost:19000
