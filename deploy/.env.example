# 本项目生产模板；在部署机保存为 $DEPLOY_PATH/deploy/.env，真实配置不入库。
# 各项目共享网络、共享密钥和数据库凭据须保持一致。
# AETHER_RELEASE_TAG / AETHER_RELEASE_ROOT 由工作流设置，不写入配置。

# 默认使用 OSS；启用内置 MinIO 时设置 minio，并填写对应存储变量。
COMPOSE_PROFILES=

# 应用端口绑定的宿主地址。默认仅回环，由同宿主的外部网关反代并终止 TLS。
# 仅当网关位于其他主机时才改为 0.0.0.0，并确保宿主防火墙已收敛。
BIND_ADDR=127.0.0.1

# Java Admin 对外端口，容器内固定 8080。
ADMIN_PORT=8080

# Front Spring Boot 服务对外端口，容器内固定 8080。
FRONT_PORT=8081

# MinIO S3 API 对外端口，容器内固定 9000。
# 该地址需被外部网关反代到 MINIO_PUBLIC_ENDPOINT，否则预签名下载链接不可用。
MINIO_API_PORT=9000

# 显式固定大版本，避免 :latest 在生产漂移。必须使用 pgvector 镜像：
# V1 迁移会执行 CREATE EXTENSION vector。
# 从 16 升到 18 不能只换这一行：PG18 的 PGDATA 布局已变，且不能就地读取 PG16 的数据目录，
# 须按运维手册「PG 16 → 18 迁移」一节先备份再恢复。
POSTGRES_IMAGE=pgvector/pgvector:pg18

# 初始化数据库名与用户名。
POSTGRES_DB=aether

POSTGRES_USER=aether

# 【必填】PostgreSQL 密码。
POSTGRES_PASSWORD=replace-with-a-strong-db-password

# 【必填】Java 侧数据库密码，须与 POSTGRES_PASSWORD 一致。
DB_PASSWORD=replace-with-a-strong-db-password

# Java 访问 PostgreSQL 的容器内 JDBC 连接地址。
DB_URL=jdbc:postgresql://postgres:5432/aether

# Java 访问 PostgreSQL 的用户名，须与 POSTGRES_USER 一致。
DB_USERNAME=aether

POSTGRES_MEM_LIMIT=2g

POSTGRES_MEM_RESERVATION=1g

# 显式固定版本。
REDIS_IMAGE=redis:7-alpine

# 【必填】Redis 访问密码。容器以 --requirepass 启动，Java 侧通过
# SPRING_REDIS_PASSWORD 绑定（Spring Boot 2.7 的 spring.redis.password）。
REDIS_PASSWORD=replace-with-a-strong-redis-password

# Redis 容器在共享网络中的主机名。
REDIS_HOST=redis

REDIS_MEM_LIMIT=768m

REDIS_MEM_RESERVATION=256m

# 存储提供方：oss（生产默认）或 minio（内置兜底，需配合 --profile minio）。
STORAGE_PROVIDER=oss

# 【必填】OSS 访问域名，例如 oss-cn-hangzhou.aliyuncs.com。
OSS_ENDPOINT=replace-with-your-oss-endpoint

# 【必填】OSS 访问密钥。建议使用仅授权该 bucket 的 RAM 子账号，而非主账号 AK。
OSS_ACCESS_KEY_ID=replace-with-your-oss-access-key-id

OSS_ACCESS_KEY_SECRET=replace-with-your-oss-access-key-secret

# 【必填】各业务共用的 bucket 名称；不同业务通过对象键前缀隔离。
# 服务启动时会自动创建 bucket，无需手工初始化。
OSS_BUCKET=aether-s

# 可选：绑定的自定义域名，生成临时下载链接时使用。
OSS_PUBLIC_ENDPOINT=

# 可选：如需按业务分桶，填写下面四项（优先级高于 OSS_BUCKET）；留空则统一使用 OSS_BUCKET。
STORAGE_FILE_BUCKET=

STORAGE_KNOWLEDGE_BUCKET=

STORAGE_SKILL_BUCKET=

STORAGE_ARTIFACT_BUCKET=

# 显式固定版本，避免 :latest 在生产漂移。
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z

# MinIO 管理员账号与密码；MINIO_ACCESS_KEY / MINIO_SECRET_KEY 须与之一致。
# 留空时 MinIO 会拒绝启动——这是刻意的响亮失败，避免误用弱口令。
MINIO_ROOT_USER=

MINIO_ROOT_PASSWORD=

MINIO_ACCESS_KEY=

MINIO_SECRET_KEY=

# 容器内访问地址。
MINIO_ENDPOINT=http://minio:9000

# 浏览器可达的 MinIO 地址（预签名下载链接使用）；须为外部网关暴露的域名，不能填 minio:9000。
MINIO_PUBLIC_ENDPOINT=

MINIO_MEM_LIMIT=1g

MINIO_MEM_RESERVATION=512m

# 【必填】SMTP 服务器地址，例如 smtp.qq.com。
SMTP_HOST=

# SMTP 端口；465 对应 SSL。
SMTP_PORT=465

# 【必填】SMTP 登录账号。
SMTP_USERNAME=

# 【必填】SMTP 授权码/密码。仓库内已提交的旧凭据请一并轮换。
SMTP_PASSWORD=

# 【必填】Java 与 Deep Agent 回调验签共用密钥。
AETHER_DEEP_AGENT_SHARED_SECRET=replace-with-a-long-random-secret

# 【必填】Java 签发、MCP 校验工具委派 JWT 共用密钥。
AETHER_MCP_DELEGATION_SECRET=replace-with-a-long-random-secret

# 【必填】签发调用方 SMTP 临时凭据令牌的共用密钥（Java 与 MCP 一致）。
AETHER_MCP_CREDENTIAL_SECRET=replace-with-a-long-random-secret

# 【必填】Sandbox Runner 领取冻结任务的服务凭据；仅 Runner 可使用。
AETHER_SANDBOX_RUNNER_TOKEN=replace-with-a-long-random-token

# 【必填】审计载荷加密密钥；留空时审计数据明文落库。
AGENT_AUDIT_ENCRYPTION_KEY=replace-with-a-long-random-secret

# 密钥标识，须与 Deep Agent 侧一致。
AETHER_DEEP_AGENT_KEY_ID=deep-agent-v1

# Java 调用 Deep Agent 的容器内地址。
AETHER_DEEP_AGENT_BASE_URL=http://aether-deep-agent:8010

# Java 调用文档解析服务（即 MCP）的地址。
ANYDOC_SERVICE_URL=http://aether-mcp:8000

# Deep Agent 单次运行超时（秒）。
AETHER_DEEP_AGENT_RUN_TIMEOUT_SECONDS=600

# Admin/Front 优雅停机超时；应不短于网关的 drain 窗口。
SERVER_SHUTDOWN_TIMEOUT=30s

# 共享网络名称，带 aether-prod_ 卷/网络前缀隔离；外部网关容器需加入该网络。
AETHER_SHARED_NETWORK=aether-prod-services

# 服务账号访问令牌有效期（秒），上限 3600。
AETHER_SERVICE_ACCOUNT_ACCESS_TOKEN_SECONDS=900

# 业务工作流回调：默认关闭。启用时必须同时配置 ALLOWED_HOSTS 与 SIGNING_SECRET。
AETHER_WORKFLOW_CALLBACK_ENABLED=false

AETHER_WORKFLOW_CALLBACK_ALLOWED_HOSTS=

AETHER_WORKFLOW_CALLBACK_SIGNING_SECRET=

# 工作流 HTTP 节点的出站主机白名单；留空表示拒绝全部出站目标。
AETHER_WORKFLOW_HTTP_ALLOWED_HOSTS=

ADMIN_MEM_LIMIT=1g

ADMIN_MEM_RESERVATION=768m

FRONT_MEM_LIMIT=1g

FRONT_MEM_RESERVATION=768m
