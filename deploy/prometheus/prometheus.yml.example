global:
  scrape_interval: 15s

rule_files:
  - /etc/prometheus/aether-alerts.yml

scrape_configs:
  - job_name: aether-admin
    metrics_path: /actuator/prometheus
    static_configs:
      - targets: ["${AETHER_ADMIN_METRICS_TARGET:-aether-admin:8080}"]
  - job_name: aether-front
    metrics_path: /actuator/prometheus
    static_configs:
      - targets: ["${AETHER_FRONT_METRICS_TARGET:-aether-front:8080}"]
