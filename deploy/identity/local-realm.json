{
  "realm": "aether-local",
  "enabled": true,
  "registrationAllowed": false,
  "users": [{
    "username": "aether-test-user",
    "firstName": "Aether",
    "lastName": "Test",
    "enabled": true,
    "email": "aether-test-user@local.test",
    "emailVerified": true,
    "credentials": [{"type": "password", "value": "aether-local-password", "temporary": false}]
  }],
  "clients": [{
    "clientId": "aether-admin-local",
    "enabled": true,
    "protocol": "openid-connect",
    "publicClient": false,
    "secret": "aether-local-oidc-secret",
    "standardFlowEnabled": true,
    "directAccessGrantsEnabled": true,
    "redirectUris": ["http://localhost:8080/*"],
    "webOrigins": ["http://localhost:8080"]
  }, {
    "clientId": "aether-admin-saml-local",
    "enabled": true,
    "protocol": "saml",
    "clientAuthenticatorType": "client-secret",
    "redirectUris": ["http://localhost:8080/*"],
    "attributes": {
      "saml.authnstatement": "true",
      "saml.server.signature": "true",
      "saml.signature.algorithm": "RSA_SHA256",
      "saml_name_id_format": "username"
    }
  }]
}
