# 生产环境变量模板。复制为 .env.prod 后填写全部 replace-with-* 占位值。
#   cp .env.prod.example .env.prod
#   docker compose --env-file .env.prod -f docker-compose.prod.yml config
# .env.prod 已在 .gitignore 中，切勿提交。
#
# 本模板中标记为「必填」的变量在 compose 里使用 ${VAR:?} 形式：缺失或为空时
# `docker compose config` 会直接报错，而不是静默回落到开发环境弱口令。
# 随机值可用：openssl rand -base64 32
#
# 注意：下面「源码来源」一节的变量不参与 Compose 插值，它们由 scripts/fetch-sources.sh
# 读取并用于检出源码；Compose 只从检出后的本地目录构建。

# ---------------------------------------------------------------------------
# 绑定地址与端口
# ---------------------------------------------------------------------------

# 应用端口绑定的宿主地址。默认仅回环，由同宿主的外部网关反代并终止 TLS。
# 仅当网关位于其他主机时才改为 0.0.0.0，并确保宿主防火墙已收敛。
BIND_ADDR=127.0.0.1

# Java Admin 对外端口，容器内固定 8080。
ADMIN_PORT=8080

# Front Spring Boot 服务对外端口，容器内固定 8080。
FRONT_PORT=8081

# Dashboard（React + Nginx）对外端口，容器内固定 80。
DASHBOARD_PORT=8001

# MinIO S3 API 对外端口，容器内固定 9000。
# 该地址需被外部网关反代到 MINIO_PUBLIC_ENDPOINT，否则预签名下载链接不可用。
MINIO_API_PORT=9000

# Deep Agent 对外端口，容器内固定 8010。
AETHER_DEEP_AGENT_PORT=8010

# MCP 服务对外端口，容器内固定 8000。
MCP_PORT=8000

# ---------------------------------------------------------------------------
# 源码来源（由 scripts/fetch-sources.sh 在部署机上检出，Compose 从本地目录构建）
# ---------------------------------------------------------------------------
#
# 为什么不用 Compose 的 Git 上下文：BuildKit 的 git 源由构建器自己 clone，不读取宿主机的 git
# 配置——credential.helper、~/.git-credentials、~/.netrc、SSH 私钥一律不生效，所以「服务器上已经
# 配好 git 权限」对它没有帮助，私有仓库拉不下来。改为先用宿主机 git 检出，再让 Compose 从本地
# 目录构建，git 凭据就回到了它本来生效的地方，也不需要额外维护一个访问令牌。
#
# 部署流程：
#   ./scripts/fetch-sources.sh    # 检出/更新下列 ref，并打印每个仓库的提交 SHA
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
#
# 首次执行前，确认部署机上的 git 能直接拉取这四仓库（HTTPS 走 credential helper，或配好 SSH key）：
#   git ls-remote <仓库地址>

# 四个仓库的检出根目录。相对路径按 docker-compose.prod.yml 所在目录解析。
# 该目录由 fetch-sources.sh 专用（脚本会对其执行 git clean -ffdx），不要放别的东西。
AETHER_SOURCE_ROOT=.sources

# Java Admin 源码仓库；front 复用同一仓库。检出到 $AETHER_SOURCE_ROOT/aether
AETHER_ADMIN_GIT_URL=https://github.com/sunjin0/aether.git

# Admin 使用的分支、标签或提交 SHA。生产建议固定到 tag 或 SHA，而非 master。
AETHER_ADMIN_GIT_REF=master

# Deep Agent 源码仓库。检出到 $AETHER_SOURCE_ROOT/aether-deep-agent-service
AETHER_DEEP_AGENT_GIT_URL=https://github.com/sunjin0/aether-deep-agent-service.git
AETHER_DEEP_AGENT_GIT_REF=master

# MCP 源码仓库；sandbox-runner 与两个 sandbox 运行时镜像也来自这里。
# 检出到 $AETHER_SOURCE_ROOT/aether-mcp-server
AETHER_MCP_GIT_URL=https://github.com/sunjin0/aether-mcp-server.git
AETHER_MCP_GIT_REF=master

# Dashboard 源码仓库。检出到 $AETHER_SOURCE_ROOT/aether-dashboard
AETHER_DASHBOARD_GIT_URL=https://github.com/sunjin0/aether-dashboard.git
AETHER_DASHBOARD_GIT_REF=master

# 构建产物镜像名（`docker compose build` 后打上的本地标签）。
AETHER_ADMIN_IMAGE=aether-admin:prod
AETHER_FRONT_IMAGE=aether-front:prod
AETHER_DEEP_AGENT_IMAGE=aether-deep-agent:prod
AETHER_MCP_IMAGE=aether-mcp:prod
AETHER_DASHBOARD_IMAGE=aether-dashboard:prod
AETHER_SANDBOX_RUNNER_IMAGE=aether-sandbox-runner:prod

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------

# 显式固定大版本，避免 :latest 在生产漂移。必须使用 pgvector 镜像：
# V1 迁移会执行 CREATE EXTENSION vector。
# 必须与 .github/workflows/release.yml 的 services.postgres 写同一个串。
# 从 16 升到 18 不能只换这一行：PG18 的 PGDATA 布局已变，且不能就地读取 PG16 的数据目录，
# 须按运维手册「PG 16 → 18 迁移」一节先备份再恢复。
POSTGRES_IMAGE=pgvector/pgvector:pg18

# 初始化数据库名与用户名。
POSTGRES_DB=aether
POSTGRES_USER=aether

# 【必填】PostgreSQL 密码。
POSTGRES_PASSWORD=replace-with-a-strong-db-password

# 【必填】Java 侧数据库密码，须与 POSTGRES_PASSWORD 一致。
DB_PASSWORD=replace-with-a-strong-db-password

# Java 访问 PostgreSQL 的容器内 JDBC 连接地址。
DB_URL=jdbc:postgresql://postgres:5432/aether

# Java 访问 PostgreSQL 的用户名，须与 POSTGRES_USER 一致。
DB_USERNAME=aether

POSTGRES_MEM_LIMIT=2g
POSTGRES_MEM_RESERVATION=1g

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------

# 显式固定版本。
REDIS_IMAGE=redis:7-alpine

# 【必填】Redis 访问密码。容器以 --requirepass 启动，Java 侧通过
# SPRING_REDIS_PASSWORD 绑定（Spring Boot 2.7 的 spring.redis.password）。
REDIS_PASSWORD=replace-with-a-strong-redis-password

# Redis 容器在共享网络中的主机名。
REDIS_HOST=redis

REDIS_MEM_LIMIT=768m
REDIS_MEM_RESERVATION=256m

# ---------------------------------------------------------------------------
# 对象存储（生产默认阿里云 OSS）
# ---------------------------------------------------------------------------

# 存储提供方：oss（生产默认）或 minio（内置兜底，需配合 --profile minio）。
STORAGE_PROVIDER=oss

# 【必填】OSS 访问域名，例如 oss-cn-hangzhou.aliyuncs.com。
OSS_ENDPOINT=replace-with-your-oss-endpoint

# 【必填】OSS 访问密钥。建议使用仅授权该 bucket 的 RAM 子账号，而非主账号 AK。
OSS_ACCESS_KEY_ID=replace-with-your-oss-access-key-id
OSS_ACCESS_KEY_SECRET=replace-with-your-oss-access-key-secret

# 【必填】各业务共用的 bucket 名称；不同业务通过对象键前缀隔离。
# 服务启动时会自动创建 bucket，无需手工初始化。
OSS_BUCKET=aether-s

# 可选：绑定的自定义域名，生成临时下载链接时使用。
OSS_PUBLIC_ENDPOINT=

# 可选：如需按业务分桶，填写下面四项（优先级高于 OSS_BUCKET）；留空则统一使用 OSS_BUCKET。
STORAGE_FILE_BUCKET=
STORAGE_KNOWLEDGE_BUCKET=
STORAGE_SKILL_BUCKET=
STORAGE_ARTIFACT_BUCKET=

# ---------------------------------------------------------------------------
# 内置 MinIO（次要兜底，默认不启动）
# ---------------------------------------------------------------------------

# 仅在需要脱离云服务自托管时使用：
#   docker compose --env-file .env.prod -f docker-compose.prod.yml --profile minio up -d
# 并须同时把上方 STORAGE_PROVIDER 改为 minio。注意 OSS_* 三项在 compose 中是强制校验的，
# 切到 MinIO 时也应保留非空值——应用在 minio 模式下不会读取它们。

# 显式固定版本，避免 :latest 在生产漂移。
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z

# MinIO 管理员账号与密码；MINIO_ACCESS_KEY / MINIO_SECRET_KEY 须与之一致。
# 留空时 MinIO 会拒绝启动——这是刻意的响亮失败，避免误用弱口令。
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# 容器内访问地址。
MINIO_ENDPOINT=http://minio:9000

# 浏览器可达的 MinIO 地址（预签名下载链接使用）；须为外部网关暴露的域名，不能填 minio:9000。
MINIO_PUBLIC_ENDPOINT=

MINIO_MEM_LIMIT=1g
MINIO_MEM_RESERVATION=512m

# ---------------------------------------------------------------------------
# 邮件（覆盖 application-prod.yml 中明文提交的 SMTP 凭据）
# ---------------------------------------------------------------------------

# 【必填】SMTP 服务器地址，例如 smtp.qq.com。
SMTP_HOST=
# SMTP 端口；465 对应 SSL。
SMTP_PORT=465

# 【必填】SMTP 登录账号。
SMTP_USERNAME=

# 【必填】SMTP 授权码/密码。仓库内已提交的旧凭据请一并轮换。
SMTP_PASSWORD=

# ---------------------------------------------------------------------------
# 共享密钥（四处必须保持一致，生产严禁沿用 dev 默认值）
# ---------------------------------------------------------------------------

# 【必填】Java 与 Deep Agent 回调验签共用密钥。
AETHER_DEEP_AGENT_SHARED_SECRET=replace-with-a-long-random-secret

# 【必填】Java 签发、MCP 校验工具委派 JWT 共用密钥。
AETHER_MCP_DELEGATION_SECRET=replace-with-a-long-random-secret

# 【必填】签发调用方 SMTP 临时凭据令牌的共用密钥（Java 与 MCP 一致）。
AETHER_MCP_CREDENTIAL_SECRET=replace-with-a-long-random-secret

# 【必填】Sandbox Runner 领取冻结任务的服务凭据；仅 Runner 可使用。
AETHER_SANDBOX_RUNNER_TOKEN=replace-with-a-long-random-token

# 【必填】审计载荷加密密钥；留空时审计数据明文落库。
AGENT_AUDIT_ENCRYPTION_KEY=replace-with-a-long-random-secret

# 密钥标识，须与 Deep Agent 侧一致。
AETHER_DEEP_AGENT_KEY_ID=deep-agent-v1

# ---------------------------------------------------------------------------
# 服务间地址
# ---------------------------------------------------------------------------

# Java 调用 Deep Agent 的容器内地址。
AETHER_DEEP_AGENT_BASE_URL=http://aether-deep-agent:8010

# Deep Agent 回调 Java Admin 的容器内地址。
AETHER_DEEP_AGENT_CALLBACK_BASE_URL=http://aether-admin:8080

# Deep Agent 调用 MCP 的容器内地址。
AETHER_DEEP_AGENT_MCP_URL=http://aether-mcp:8000/mcp

# MCP 与 Runner 访问 Java 附件下载接口的内部地址。
AETHER_ADMIN_INTERNAL_URL=http://aether-admin:8080

# Dashboard Nginx 代理到 Java Admin 的容器内地址。
AETHER_ADMIN_UPSTREAM=http://aether-admin:8080

# Java 调用文档解析服务（即 MCP）的地址。
ANYDOC_SERVICE_URL=http://aether-mcp:8000

# Deep Agent 单次运行超时（秒）。
AETHER_DEEP_AGENT_RUN_TIMEOUT_SECONDS=600

# Admin/Front 优雅停机超时；应不短于网关的 drain 窗口。
SERVER_SHUTDOWN_TIMEOUT=30s

# 共享网络名称，带 aether-prod_ 卷/网络前缀隔离；外部网关容器需加入该网络。
AETHER_SHARED_NETWORK=aether-prod-services

# ---------------------------------------------------------------------------
# 模型供应商
# ---------------------------------------------------------------------------

# 说明：Java Admin/Front 不读取下列变量——模型凭据取自数据库 ModelProvider 表
#（api_base_url + AES 加密的 api_key）。只有 Deep Agent 与 MCP 使用这里配置。

# Deep Agent 使用的模型标识。
AETHER_DEEP_AGENT_MODEL=openai:gpt-4.1-mini

# Deep Agent 运行、计划、检查点数据库连接。
# 留空时由 compose 依据 POSTGRES_* 自动拼接；若密码含 @ : / 等字符，
# 必须在此显式填写 URL 编码后的完整 DSN。
AETHER_DEEP_AGENT_DATABASE_URL=

# OpenAI 兼容模型服务；使用其他模型时可留空。
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# MCP 下载 Hugging Face 模型使用的地址；网络受限时可改为镜像站点。
HF_ENDPOINT=https://huggingface.co

# MCP 解析文档内嵌图片时调用的 OpenAI 兼容视觉模型；三项均配置后启用。
AETHER_VISION_API_BASE_URL=
AETHER_VISION_MODEL=
AETHER_VISION_API_KEY=

# ---------------------------------------------------------------------------
# MCP 与 Sandbox
# ---------------------------------------------------------------------------

# MCP 容器 CPU 上限。
AETHER_MCP_CPU_LIMIT=2.0
MCP_MEM_LIMIT=3g
MCP_MEM_RESERVATION=1g

# 文档解析并发与底层计算线程限制；默认串行，避免大文件解析占满宿主 CPU。
AETHER_DOCUMENT_MAX_CONCURRENCY=1
AETHER_OCR_DESKEW=false
OMP_THREAD_LIMIT=1
OMP_NUM_THREADS=1

# Runner 在无网络的任务容器中使用的固定运行时镜像标签。
AETHER_SANDBOX_PYTHON_IMAGE=aether-sandbox-python:prod
AETHER_SANDBOX_NODE_IMAGE=aether-sandbox-node:prod

# Runner 实例标识。
AETHER_SANDBOX_RUNNER_ID=sandbox-prod-1

# 允许执行的镜像 sha256 摘要白名单；留空表示不校验，生产建议填写。
AETHER_SANDBOX_ALLOWED_IMAGE_DIGESTS=

# ---------------------------------------------------------------------------
# 可选业务开关
# ---------------------------------------------------------------------------

# 服务账号访问令牌有效期（秒），上限 3600。
AETHER_SERVICE_ACCOUNT_ACCESS_TOKEN_SECONDS=900

# 业务工作流回调：默认关闭。启用时必须同时配置 ALLOWED_HOSTS 与 SIGNING_SECRET。
AETHER_WORKFLOW_CALLBACK_ENABLED=false
AETHER_WORKFLOW_CALLBACK_ALLOWED_HOSTS=
AETHER_WORKFLOW_CALLBACK_SIGNING_SECRET=

# 工作流 HTTP 节点的出站主机白名单；留空表示拒绝全部出站目标。
AETHER_WORKFLOW_HTTP_ALLOWED_HOSTS=

# ---------------------------------------------------------------------------
# 资源额度
# ---------------------------------------------------------------------------

ADMIN_MEM_LIMIT=1g
ADMIN_MEM_RESERVATION=768m
FRONT_MEM_LIMIT=1g
FRONT_MEM_RESERVATION=768m
DEEP_AGENT_MEM_LIMIT=1g
DEEP_AGENT_MEM_RESERVATION=512m
DASHBOARD_MEM_LIMIT=256m
DASHBOARD_MEM_RESERVATION=128m
