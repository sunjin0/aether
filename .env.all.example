# 一键部署创建的 Docker 共享网络名称。
AETHER_SHARED_NETWORK=aether-services

# Java Admin 源码 Git 仓库地址；部署时由 Docker BuildKit 克隆。
AETHER_ADMIN_GIT_URL=https://github.com/sunjin0/aether.git

# Java Admin 使用的 Git 分支、标签或提交 SHA。
AETHER_ADMIN_GIT_REF=master

# Deep Agent 源码 Git 仓库地址；部署时由 Docker BuildKit 克隆。
AETHER_DEEP_AGENT_GIT_URL=https://github.com/sunjin0/aether-deep-agent-service.git

# Deep Agent 使用的 Git 分支、标签或提交 SHA。
AETHER_DEEP_AGENT_GIT_REF=master

# MCP 源码 Git 仓库地址；部署时由 Docker BuildKit 克隆。
AETHER_MCP_GIT_URL=https://github.com/sunjin0/aether-mcp-server.git

# MCP 使用的 Git 分支、标签或提交 SHA。
AETHER_MCP_GIT_REF=master

# Dashboard 源码 Git 仓库地址；部署时由 Docker BuildKit 克隆。
AETHER_DASHBOARD_GIT_URL=https://github.com/sunjin0/aether-dashboard.git

# Dashboard 使用的 Git 分支、标签或提交 SHA。
AETHER_DASHBOARD_GIT_REF=master

# Admin/Front 优雅停机阶段超时；滚动发布时应覆盖为符合 drain 窗口的值。
SERVER_SHUTDOWN_TIMEOUT=30s

# PostgreSQL 对外暴露的宿主机端口，容器内仍使用 5432。
POSTGRES_PORT=15432

# Redis 对外暴露的宿主机端口，容器内仍使用 6379。
REDIS_PORT=16379

# MinIO S3 API 对外暴露的宿主机端口，容器内仍使用 9000。
MINIO_API_PORT=19000

# MinIO 管理控制台对外暴露的宿主机端口，容器内仍使用 9001。
MINIO_CONSOLE_PORT=19001

# Java Admin 对外暴露的宿主机端口，容器内仍使用 8080。
ADMIN_PORT=18080

# Front Spring Boot 服务对外暴露的宿主机端口，容器内仍使用 8080。
FRONT_PORT=18081

# Dashboard 对外暴露的宿主机端口，容器内仍使用 80。
DASHBOARD_PORT=18001

# Deep Agent 对外暴露的宿主机端口，容器内仍使用 8010。
AETHER_DEEP_AGENT_PORT=18010

# MCP 服务对外暴露的宿主机端口，容器内仍使用 8000。
MCP_PORT=18000

# PostgreSQL 初始化数据库名称。
POSTGRES_DB=aether

# PostgreSQL 初始化登录用户名。
POSTGRES_USER=aether

# PostgreSQL 初始化登录密码；生产环境请改为强密码。
POSTGRES_PASSWORD=aether_dev

# Redis 容器在共享网络中的主机名。
REDIS_HOST=redis

# Java 访问 PostgreSQL 的容器内 JDBC 连接地址。
DB_URL=jdbc:postgresql://postgres:5432/aether

# PostgreSQL 登录用户名。
DB_USERNAME=aether

# PostgreSQL 登录密码；生产环境请改为强密码。
DB_PASSWORD=aether_dev

# MinIO 服务在共享网络中的访问地址。
MINIO_ENDPOINT=http://minio:9000

# Java 访问 MinIO 的访问密钥，需与 MINIO_ROOT_USER 保持一致。
MINIO_ACCESS_KEY=minioadmin

# Java 访问 MinIO 的私密访问密钥，需与 MINIO_ROOT_PASSWORD 保持一致。
MINIO_SECRET_KEY=minioadmin

# MinIO 管理员访问密钥；生产环境请替换。
MINIO_ROOT_USER=minioadmin

# MinIO 管理员私密访问密钥；生产环境请替换。
MINIO_ROOT_PASSWORD=minioadmin

# 浏览器访问 MinIO 的公网地址。生产环境请改为实际域名或反向代理地址。
MINIO_PUBLIC_ENDPOINT=http://localhost:19000

# 知识库文件使用的 MinIO Bucket 名称。
MINIO_KNOWLEDGE_BUCKET=aether-knowledge

# 普通上传文件使用的 MinIO Bucket 名称。
MINIO_FILE_BUCKET=aether

# 对象存储提供方：minio（默认）或 oss。设为 oss 时，OSS Bucket 请先在阿里云控制台创建；各业务使用对象键前缀隔离。
STORAGE_PROVIDER=minio
OSS_ENDPOINT=
# 可选：绑定的自定义域名，生成临时下载链接时使用。
OSS_PUBLIC_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=

# Java 服务调用 Deep Agent 的容器内地址。
AETHER_DEEP_AGENT_BASE_URL=http://aether-deep-agent:8010

# Deep Agent 回调 Java Admin 的容器内地址。
AETHER_DEEP_AGENT_CALLBACK_BASE_URL=http://aether-admin:8080

# Deep Agent 调用 MCP 的容器内地址。
AETHER_DEEP_AGENT_MCP_URL=http://aether-mcp:8000/mcp

# Deep Agent 使用的模型标识。
AETHER_DEEP_AGENT_MODEL=openai:gpt-4.1-mini

# Deep Agent 运行、计划、检查点数据库连接；与平台共用 PostgreSQL 服务。
AETHER_DEEP_AGENT_DATABASE_URL=postgresql+asyncpg://aether:aether_dev@postgres:5432/aether

# Java 与 Deep Agent 回调验签共用密钥；生产环境必须替换。
AETHER_DEEP_AGENT_SHARED_SECRET=aether-deep-agent-dev-secret-change-me
ANYDOC_SERVICE_URL=http://aether-mcp:8000

# Java 签发、MCP 校验工具委派 JWT 共用密钥；生产环境必须替换。
AETHER_MCP_DELEGATION_SECRET=aether-mcp-delegation-dev-secret-change-me

# OIDC 默认关闭；生产环境需由企业 IdP 注入实际客户端配置。
AETHER_OIDC_ENABLED=false
AETHER_OIDC_ISSUER_URI=
AETHER_OIDC_AUTHORIZATION_URI=
AETHER_OIDC_TOKEN_URI=
AETHER_OIDC_JWKS_URI=
AETHER_OIDC_CLIENT_ID=
AETHER_OIDC_CLIENT_SECRET=
AETHER_OIDC_REDIRECT_URI=
AETHER_OIDC_AUTO_PROVISION=false
AETHER_OIDC_SCOPES=openid,profile,email

# SCIM 默认关闭；启用时必须绑定独立凭据和单一租户。
AETHER_SCIM_ENABLED=false
AETHER_SCIM_BASE_PATH=/scim/v2
AETHER_SCIM_BEARER_TOKEN=
AETHER_SCIM_TENANT_ID=

# SAML 默认关闭；当前仅提供配置契约，尚未开放登录回调。
AETHER_SAML_ENABLED=false
AETHER_SAML_METADATA_DRIVEN=false
AETHER_SAML_ENTITY_ID=
AETHER_SAML_METADATA_URI=
AETHER_SAML_IDP_ENTITY_ID=
AETHER_SAML_CERTIFICATE=
AETHER_SAML_SSO_URL=
AETHER_SAML_REDIRECT_URI=
AETHER_ADMIN_OTEL_ENABLED=false
AETHER_ADMIN_OTEL_ENDPOINT=http://otel-collector:4318/v1/traces
AETHER_ADMIN_OTEL_SERVICE_NAME=aether-admin
AETHER_ADMIN_OTEL_LOGS_ENABLED=false
AETHER_ADMIN_OTEL_LOGS_ENDPOINT=http://otel-collector:4318/v1/logs

# 外部 Secret Provider 默认使用本地实现；可选 vault 或 kubernetes，启用前必须配置租户隔离路径和访问凭据。
AETHER_SECRET_PROVIDER=local
AETHER_VAULT_API_BASE=https://vault:8200
AETHER_VAULT_TOKEN=
AETHER_KUBERNETES_NAMESPACE=default
AETHER_KUBERNETES_API_BASE=https://kubernetes.default.svc:443
AETHER_KUBERNETES_BEARER_TOKEN=

# MCP OpenTelemetry 默认关闭；启用时填写 Collector OTLP/HTTP endpoints。
AETHER_OTLP_TRACES_ENABLED=false
AETHER_OTLP_TRACES_URL=
AETHER_OTLP_LOGS_URL=
AETHER_MCP_OTEL_SERVICE_NAME=aether-mcp-server

# Sandbox Runner 领取冻结任务的服务凭据；生产环境必须替换。
AETHER_SANDBOX_RUNNER_TOKEN=aether-sandbox-runner-dev-secret-change-me

# Sandbox Runner 在无网络的任务容器中使用的固定运行时镜像标签。
AETHER_SANDBOX_PYTHON_IMAGE=aether-sandbox-python:1
AETHER_SANDBOX_NODE_IMAGE=aether-sandbox-node:1

# OpenAI 兼容模型服务的访问密钥；使用其他模型时可留空。
OPENAI_API_KEY=

# OpenAI 兼容模型服务的基础地址；使用官方服务时可留空。
OPENAI_BASE_URL=

# Anthropic 模型服务访问密钥；未使用可留空。
ANTHROPIC_API_KEY=

# Google 模型服务访问密钥；未使用可留空。
GOOGLE_API_KEY=

# MCP 下载 Hugging Face 模型时使用的服务地址；网络受限时可改为镜像地址。
HF_ENDPOINT=https://huggingface.co

# MCP 文档解析并发及底层计算线程限制；默认串行，避免大文件解析占满宿主机 CPU。
AETHER_MCP_CPU_LIMIT=2.0
AETHER_DOCUMENT_MAX_CONCURRENCY=1
AETHER_OCR_DESKEW=false
OMP_THREAD_LIMIT=1
OMP_NUM_THREADS=1

# MCP 在解析到文档内嵌图片时使用的 OpenAI 兼容视觉模型。三项均配置后启用；未配置时仅执行 OCR。
AETHER_VISION_API_BASE_URL=
AETHER_VISION_MODEL=
AETHER_VISION_API_KEY=

# MCP 容器访问 Java 附件下载接口的内部地址。
AETHER_ADMIN_INTERNAL_URL=http://aether-admin:8080

# Dashboard Nginx 代理到 Java Admin 的容器内地址。
AETHER_ADMIN_UPSTREAM=http://aether-admin:8080

# Java 服务运行内存限制；可按宿主机资源调整。
ADMIN_MEM_LIMIT=1g
ADMIN_MEM_RESERVATION=768m
FRONT_MEM_LIMIT=1g
FRONT_MEM_RESERVATION=768m
